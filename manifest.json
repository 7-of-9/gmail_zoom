{
  "manifest_version": 3,
  "name": "Pane Zoom for Gmail",
  "version": "1.4.1",
  "description": "Zoom only the Gmail reading pane: one text size for all mail, synced across your machines. No login. Cmd/Ctrl +/− zoom.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Pane Zoom for Gmail",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "homepage_url": "https://7-of-9.github.io/gmail_zoom/",
  "permissions": ["contextMenus", "storage"],
  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
